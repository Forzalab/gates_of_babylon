{
  "version": 1,
  "note": "date-beta demo spine: shared scenes -> door -> cup (steeped | unknown -> escape) | leave; every ending card goes back to splash. bg = art id in src/date-beta/art; props carry forward beat to beat; text <= 12 words (an OR is only ever the explicit token {OR}, rule C: that line gets the dark box); scare = 0|1|2 dread (beat, else scene, else 0); choices = [{ text, side?: pink|purple, go?, if?, set?, default? }]; timer/set/speaker/sprite/defaults: see SCENES.md; sfx = cue name or manifest id; rmAlt = what reduced motion does (same | hard-cut | static | skip).",
  "scenes": [
    {
      "id": "splash",
      "title": "START / house of cards",
      "bg": "splash",
      "beats": [
        { "props": { "collapsed": false }, "wait": "start" },
        { "props": { "collapsed": true }, "sfx": "static", "motion": true, "rmAlt": "hard-cut", "hold": 2000 }
      ]
    },
    {
      "id": "rooftop",
      "title": "Rooftop / clock tower",
      "bg": "rooftop",
      "enter": "fade",
      "defaults": { "stayed": false },
      "beats": [
        { "props": { "clock": "live" }, "text": "Lunch on the roof. The tower keeps your time.", "sfx": "wind", "hold": 1200 },
        { "props": { "clock": "noon" }, "text": "MC: Technically, rain wasn't f-{OR}-ecast.", "sfx": "bell" },
        { "props": { "clock": "noon" }, "text": "NANDA: Stay f{OR}ever? The rain can wait.", "scare": 1, "sfx": "breath", "timer": 10,
          "choices": [
            { "text": "Just one more minute, then I really have to go", "side": "pink", "default": true, "set": { "stayed": true } },
            { "text": "{OR} I could leave now, before the rain starts", "side": "purple", "set": { "stayed": false } }
          ] }
      ]
    },
    {
      "id": "train",
      "title": "Train window / NOT Sweet ad",
      "bg": "train",
      "enter": "fade",
      "beats": [
        { "props": { "zoom": false }, "text": "AND Line, local service. Home in twelve stops.", "sfx": "train-hum", "motion": true, "rmAlt": "static" },
        { "props": { "zoom": true }, "text": "Nobody reads the ads. You read this one.", "sfx": "tick", "motion": true, "rmAlt": "hard-cut", "hold": 1600 }
      ]
    },
    {
      "id": "naan",
      "title": "Hot NAAN billboard",
      "bg": "naan",
      "enter": "fade",
      "beats": [
        { "props": {}, "sfx": "tick", "motion": true, "rmAlt": "static", "hold": 1500 },
        { "text": "MC: Technically, that's a NAND gate. Not bread.", "sfx": "tick", "motion": true, "rmAlt": "static" }
      ]
    },
    {
      "id": "blackout",
      "title": "Blackout / ADORE ME",
      "bg": "blackout",
      "scare": 2,
      "beats": [
        { "props": { "phase": "dark" }, "sfx": "drone", "auto": 1000 },
        { "props": { "phase": "forecast" }, "motion": true, "rmAlt": "hard-cut", "auto": 2600 },
        { "props": { "phase": "or" }, "sfx": "breath", "motion": true, "rmAlt": "hard-cut", "auto": 2600 },
        { "props": { "phase": "dor" }, "motion": true, "rmAlt": "skip", "auto": 1500 },
        { "props": { "phase": "ador" }, "motion": true, "rmAlt": "hard-cut", "auto": 1500 },
        { "props": { "phase": "adore" }, "motion": true, "rmAlt": "skip", "auto": 1500 },
        { "props": { "phase": "adoreme" }, "motion": true, "rmAlt": "hard-cut", "auto": 2800 },
        { "props": { "phase": "fade" }, "motion": true, "rmAlt": "skip", "auto": 1800 },
        { "props": { "phase": "cut" }, "sfx": "silence", "auto": 1000 },
        { "sfx": "static", "hold": 800 }
      ]
    },
    {
      "id": "door",
      "title": "DOOR / Unit 12",
      "bg": "BG-D1",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "text": "NANDA: This is me. Unit 12. Obviously you'll remember.", "scare": 0, "sfx": "rain" },
        { "text": "NANDA: Come in? Just for tea.", "scare": 0, "sfx": "tick" },
        { "text": "NANDA: I already boiled the water. This morning. Just in case.", "sfx": "kettle", "timer": 5,
          "choices": [
            { "text": "Just one cup", "side": "pink", "default": true, "go": "cup" },
            { "text": "It's late. Goodnight", "side": "purple", "go": "leave" }
          ] }
      ]
    },
    {
      "id": "cup",
      "title": "Third cup",
      "bg": "BG-D2",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "text": "Third teacup on the table. Nobody poured it.", "sfx": "thump" },
        { "text": "MC: Who's the third cup for?", "sfx": "tick" },
        { "text": "NANDA: For Input B. Silly. It's always three of us.", "scare": 2, "sfx": "breath",
          "choices": [
            { "text": "Drink", "side": "pink", "go": "steeped" },
            { "text": "Stand up", "side": "purple", "go": "unknown" }
          ] }
      ]
    },
    {
      "id": "steeped",
      "title": "ENDING / STEEPED",
      "bg": "BG-D2",
      "scare": 2,
      "beats": [
        { "text": "{OR}", "sfx": "breath", "hold": 1000 },
        { "text": "NANDA: Rest. I'll do the remembering.", "sfx": "silence" },
        { "text": "NANDA: ずっと。…F{OR}ever. Ne?", "sfx": "breath" },
        { "text": "STEEPED.", "sfx": "static", "hold": 1500, "choices": [{ "text": "Back to start", "go": "splash" }] }
      ]
    },
    {
      "id": "unknown",
      "title": "??? (unwritten, RP pending)",
      "bg": "BG-D2",
      "scare": 1,
      "beats": [
        { "text": "[??? — RP pending]" }
      ]
    },
    {
      "id": "escape",
      "title": "ESCAPE / 4x4 puzzle (stub)",
      "bg": "BG-D3",
      "scare": 2,
      "beats": [
        { "text": "Locked in.", "sfx": "thump",
          "choices": [
            { "text": "[win]", "side": "pink", "go": "escape-win" },
            { "text": "[timeout]", "side": "purple", "go": "escape-timeout" }
          ] }
      ]
    },
    {
      "id": "escape-win",
      "title": "ENDING / ESCAPE (clear)",
      "bg": "BG-D1",
      "scare": 2,
      "beats": [
        { "text": "She's waiting at the outside door.", "sfx": "thump" },
        { "text": "NANDA: No need to leave. Home is warm, and sweet." },
        { "text": "NANDA: You picked sour. I kept you anyway.", "sfx": "breath" },
        { "bg": "blackout", "props": { "phase": "dark" }, "sfx": "drone", "auto": 1200 },
        { "text": "NANDA: Mine.", "sfx": "silence" },
        { "text": "ESCAPE.", "sfx": "static", "hold": 1500, "choices": [{ "text": "Back to start", "go": "splash" }] }
      ]
    },
    {
      "id": "escape-timeout",
      "title": "ENDING / ESCAPE (timeout)",
      "bg": "BG-D3",
      "scare": 2,
      "beats": [
        { "text": "She holds out the umeboshi. You eat.", "sfx": "thump" },
        { "text": "NANDA: You chose sour. I made it sweet.", "sfx": "breath" },
        { "text": "NANDA: Now you're mine to keep." },
        { "text": "ESCAPE.", "sfx": "static", "hold": 1500, "choices": [{ "text": "Back to start", "go": "splash" }] }
      ]
    },
    {
      "id": "leave",
      "title": "LEAVE / XOR Coffee 7:00 AM",
      "bg": "BG-D1",
      "scare": 1,
      "beats": [
        { "text": "NANDA: Leaving is not an option.", "scare": 2, "sfx": "thump" },
        { "bg": "BG-X1", "text": "XOR Coffee. 7:00 AM.", "scare": 0, "sfx": "static" },
        { "text": "NANDA: He wakes at 7:00.", "sfx": "tick" },
        { "text": "NANDA: From now on… can we be f{OR}ever?", "scare": 2, "sfx": "breath",
          "choices": [
            { "text": "uhmmm yeah ig", "side": "pink", "go": "leave-yeah" },
            { "text": "FUCK YOU. I'm leaving", "side": "purple", "go": "leave-fu" }
          ] }
      ]
    },
    {
      "id": "leave-fu",
      "title": "ENDING / LEAVE (refuse)",
      "bg": "BG-X1",
      "scare": 2,
      "beats": [
        { "text": "Her hand rises. Time freezes. The café turns.", "sfx": "silence" },
        { "text": "NANDA: You said leave. I heard 'lea—'.", "sfx": "breath" },
        { "text": "CROWD: f{OR}ever and ever", "sfx": "drone" },
        { "text": "CROWD: f{OR}ever and ever and ever", "sfx": "drone" },
        { "text": "LEAVE.", "sfx": "static", "hold": 1500, "choices": [{ "text": "Back to start", "go": "splash" }] }
      ]
    },
    {
      "id": "leave-yeah",
      "title": "ENDING / LEAVE (agree)",
      "bg": "BG-X1",
      "scare": 2,
      "beats": [
        { "text": "NANDA: Hooray! F{OR}ever and ever!", "sfx": "bell" },
        { "text": "NANDA: Good input.", "sfx": "breath" },
        { "text": "CROWD: f{OR}ever and ever", "sfx": "drone" },
        { "text": "CROWD: f{OR}ever and ever and ever", "sfx": "drone" },
        { "text": "LEAVE.", "sfx": "static", "hold": 1500, "choices": [{ "text": "Back to start", "go": "splash" }] }
      ]
    }
  ]
}
