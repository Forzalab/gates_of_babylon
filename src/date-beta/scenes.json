{
  "version": 1,
  "note": "date-beta demo spine: shared scenes (rooftop, train, naan at dusk, blackout, then alt's night walk: platform = the same station at night, underpass, apartment) -> door (stairs beat first) -> genkan-in -> cup (steeped | unknown -> escape) | leave; every ending card goes back to scene 1, the rooftop (the Figur collapse in Logic mode lands there, as if START was pressed; the old fake-site Splash art is kept but out of the play path). bg = art id in src/date-beta/art; props carry forward beat to beat; text <= 12 words (an OR is only ever the explicit token {OR}, rule C: that line gets the dark box); scare = 0|1|2 dread (beat, else scene, else 0); choices = [{ text, side?: pink|purple, go?, if?, set?, default? }]; timer/set/speaker/sprite/defaults: see SCENES.md; sfx = cue name or manifest id; rmAlt = what reduced motion does (same | hard-cut | static | skip). flags = declared pick flags; vary = per-value overlay of text/speaker/props/sprite/bg/sfx (echo rule: a line naming the bento pick must vary on bento).",
  "flags": { "bento": ["umeboshi", "tamagoyaki"], "cold": ["no", "yes"] },
  "love": { "start": 0, "goal": "auto" },
  "scenes": [
    {
      "id": "rooftop",
      "short": "ROOF",
      "title": "Rooftop / clock tower",
      "bg": "rooftop",
      "enter": "fade",
      "defaults": { "stayed": false, "bento": "umeboshi" },
      "beats": [
        { "props": { "clock": "live" }, "sfx": "wind", "hold": 1200, "card": "goal" },
        { "props": { "clock": "noon" }, "text": "NANDA: Don't look at me like that. It's not for you.", "sfx": "tick",
          "choices": [
            { "text": "Take the tamagoyaki", "side": "pink", "set": { "bento": "tamagoyaki" }, "love": 3 },
            { "text": "Take the umeboshi", "side": "purple", "set": { "bento": "umeboshi" }, "default": true, "love": 1 }
          ] },
        { "vary": {"bento": {"umeboshi": {"text": "NANDA: Sour. Hm. You like things that bite?"}, "tamagoyaki": {"text": "NANDA: Sweet. Like me. Good input."}}} },
        { "vary": {"bento": {"umeboshi": {"text": "NANDA: Sour, ne?", "props": {"pucker": true}}, "tamagoyaki": {"text": "NANDA: Sweet, ne? I rolled it myself.", "props": {"pucker": false}}}},
          "choices": [
            { "text": "Best I've ever had", "side": "pink", "love": 1, "emote": "sweat", "react": "…Obviously. Don't stare." },
            { "text": "Bit salty, honestly", "side": "purple", "love": -2, "emote": "or", "react": "Say that again. Slowly." }
          ] },
        { "vary": {"bento": {"umeboshi": {"text": "You smile for her anyway."}, "tamagoyaki": {"text": "You smile for her. It's easy."}}} },
        { "text": "MC: Technically, rain wasn't f-{OR}-ecast.", "sfx": "bell" },
        { "props": { "clock": "noon" }, "text": "NANDA: Stay f{OR}ever? The rain can wait.", "scare": 1, "sfx": "breath", "timer": 10,
          "choices": [
            { "text": "Stay a minute", "side": "pink", "default": true, "set": { "stayed": true }, "love": 3 },
            { "text": "{OR} Leave before the rain", "side": "purple", "set": { "stayed": false }, "love": -2, "emote": "or", "react": "…Fine. The rain can have you." }
          ] }
      ]
    },
    {
      "id": "train",
      "short": "TRAIN",
      "title": "Train window / NOT Sweet ad",
      "bg": "train",
      "enter": "fade",
      "beats": [
        { "props": { "zoom": false }, "text": "AND Line, local service. Home in twelve stops.", "sfx": "train-hum", "motion": true, "rmAlt": "static",
          "vary": {"bento": {"umeboshi": {"props": {"ad": "umeboshi"}}, "tamagoyaki": {"props": {"ad": "tamagoyaki"}}}} },
        { "props": { "zoom": true }, "sfx": "tick", "motion": true, "rmAlt": "hard-cut", "hold": 1600,
          "vary": {"bento": {"umeboshi": {"text": "Nobody reads the ads. This one says すっぱい！ SOUR!", "props": {"adCopy": "すっぱい！ SOUR!"}}, "tamagoyaki": {"text": "Nobody reads the ads. This one says 甘い！ SWEET!", "props": {"adCopy": "甘い！ SWEET!"}}}} }
      ]
    },
    {
      "id": "naan",
      "short": "STATION",
      "title": "Hot NAAN billboard",
      "bg": "naan",
      "enter": "fade",
      "beats": [
        { "props": {}, "sfx": "tick", "motion": true, "rmAlt": "static", "hold": 1500, "vary": {"bento": {"umeboshi": {"props": {"vending": "umeboshi"}}, "tamagoyaki": {"props": {"vending": "tamagoyaki"}}}} },
        { "text": "MC: Technically, that's a NAND gate. Not bread.", "sfx": "tick", "motion": true, "rmAlt": "static" }
      ]
    },
    {
      "id": "blackout",
      "short": "NIGHT",
      "title": "Blackout / ADORE ME",
      "bg": "blackout",
      "scare": 2,
      "beats": [
        { "props": { "phase": "dark" }, "sfx": "drone", "auto": 1000 },
        { "props": { "phase": "forecast" }, "motion": true, "rmAlt": "hard-cut", "auto": 2600 },
        { "props": { "phase": "or" }, "sfx": "breath", "motion": true, "rmAlt": "hard-cut", "auto": 2600 },
        { "props": { "phase": "dor" }, "motion": true, "rmAlt": "skip", "auto": 1500 },
        { "props": { "phase": "ador" }, "motion": true, "rmAlt": "hard-cut", "auto": 1500 },
        { "props": { "phase": "adore" }, "motion": true, "rmAlt": "skip", "auto": 1500 },
        { "props": { "phase": "adoreme" }, "motion": true, "rmAlt": "hard-cut", "auto": 2800 },
        { "props": { "phase": "fade" }, "motion": true, "rmAlt": "skip", "auto": 1800 },
        { "props": { "phase": "cut" }, "sfx": "silence", "auto": 1000 },
        { "sfx": "static", "hold": 800 }
      ]
    },
    {
      "id": "platform",
      "short": "STATION",
      "title": "Platform / NEXT: {OR} (alt)",
      "bg": "platform",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "props": { "train": "here" }, "text": "Her stop. The rain followed us off the train.", "sfx": "rain", "hold": 1200 },
        { "props": { "train": "gone" }, "text": "The AND Line leaves. Just two of us now.", "sfx": "train-hum", "motion": true, "rmAlt": "hard-cut", "hold": 1600 },
        { "text": "NEXT: this {OR} that. The sign never picks.", "speaker": false, "sfx": "breath" }
      ]
    },
    {
      "id": "underpass",
      "short": "NIGHT",
      "title": "Underpass / ads (alt)",
      "bg": "underpass",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "text": "Your steps, her steps. Always an even count.", "sfx": "tick", "hold": 1200 },
        { "text": "NANDA: Don't read the ads. Read me.", "sfx": "tick" }
      ]
    },
    {
      "id": "apartment",
      "short": "HER HOME",
      "title": "Her building / one lit window (alt)",
      "bg": "apartment",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "text": "Four floors. One window lit.", "sfx": "rain", "hold": 1000 },
        { "text": "NANDA: That's mine. I left the light on for you.", "sfx": "rain" }
      ]
    },
    {
      "id": "door",
      "short": "HER HOME",
      "title": "DOOR / Unit 12",
      "bg": "BG-D1",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "bg": "stairs", "props": { "door": "shut" }, "sfx": "tick", "hold": 1000 },
        { "bg": "BG-D1", "text": "NANDA: This is me. Unit 12. Obviously you'll remember.", "scare": 0, "sfx": "rain",
          "choices": [
            { "text": "I'll never forget it", "side": "pink", "love": 2, "emote": "heart", "react": "Good. I wrote it on your hand anyway." },
            { "text": "Which unit again?", "side": "purple", "love": -1, "emote": "pout", "react": "Twelve. Twelve. Twelve. Say it back." }
          ] },
        { "text": "NANDA: Come in? Just for tea.", "scare": 0, "sfx": "tick" },
        { "text": "NANDA: I already boiled the water. This morning. Just in case.", "sfx": "kettle", "timer": 5,
          "choices": [
            { "text": "Just one cup", "side": "pink", "default": true, "go": "genkan-in", "love": 2 },
            { "text": "Say goodnight", "side": "purple", "go": "leave", "love": -3 }
          ] }
      ]
    },
    {
      "id": "genkan-in",
      "short": "HER HOME",
      "title": "Genkan arrival insert (alt)",
      "bg": "genkan-in",
      "scare": 1,
      "beats": [
        { "props": { "insert": false }, "text": "Her shoes. Lined up to the millimetre.", "sfx": "thump", "hold": 1000 },
        { "props": { "insert": true }, "text": "Men's slippers. Already set out.", "sfx": "thump", "motion": true, "rmAlt": "hard-cut", "hold": 1600 },
        { "text": "A tiny shrine. Inside: a circuit you built.", "sfx": "breath" }
      ]
    },
    {
      "id": "cup",
      "short": "TEA",
      "title": "Third cup",
      "bg": "BG-D2",
      "enter": "fade",
      "scare": 1,
      "beats": [
        { "sfx": "kettle", "vary": {"bento": {"umeboshi": {"text": "NANDA: I bought umeboshi. For no reason. Eat.", "props": {"fridge": "umeboshi", "plate": "umeboshi"}}, "tamagoyaki": {"text": "NANDA: I made tamagoyaki. For no reason. Eat.", "props": {"fridge": "tamagoyaki", "plate": "tamagoyaki"}}}},
          "choices": [
            { "text": "Eat it all", "side": "pink", "love": 2, "emote": "hearts", "react": "See? You needed me." },
            { "text": "I'm not hungry", "side": "purple", "love": -1, "emote": "pout", "react": "You will be. Later." }
          ] },
        { "sfx": "thump", "vary": {"bento": {"umeboshi": {"text": "Third teacup. Nobody poured it. One umeboshi on its saucer."}, "tamagoyaki": {"text": "Third teacup. Nobody poured it. Tamagoyaki on its saucer."}}} },
        { "text": "MC: Who's the third cup for?", "sfx": "tick" },
        { "text": "NANDA: For Input B. Silly. It's always three of us.", "scare": 2, "sfx": "breath",
          "choices": [
            { "text": "Drink", "side": "pink", "go": "steeped", "love": 3 },
            { "text": "Stand up", "side": "purple", "go": "unknown", "love": -2, "emote": "or", "react": "Sit. The tea isn't finished." }
          ] }
      ]
    },
    {
      "id": "steeped",
      "title": "ENDING / STEEPED",
      "bg": "BG-D2",
      "scare": 2,
      "beats": [
        { "text": "{OR}", "sfx": "breath", "hold": 1000 },
        { "text": "NANDA: Rest. I'll do the remembering.", "sfx": "silence" },
        { "sfx": "breath", "vary": {"bento": {"umeboshi": {"text": "NANDA: Bitter cup, sour hour. Every hour is ours."}, "tamagoyaki": {"text": "NANDA: Warm cup, sweet sleep. You're mine to keep."}}} },
        { "text": "NANDA: いつまでも一緒。…F{OR}ever. ね？", "sfx": "breath" },
        { "text": "STEEPED.", "sfx": "static", "hold": 1500, "end": "steeped", "choices": [{ "text": "Back to start", "go": "rooftop" }] }
      ]
    },
    {
      "id": "unknown",
      "short": "HER HOME",
      "title": "Hatch / ladder",
      "bg": "BG-D2",
      "scare": 1,
      "beats": [
        { "text": "You stand. The floor tilts a little.", "sfx": "thump" },
        { "text": "Under the table: a floor hatch. Too big for storage.", "sfx": "tick",
          "choices": [{ "text": "Open the hatch", "side": "purple" }] },
        { "text": "A steep wooden ladder. Down into the dark.", "sfx": "drone",
          "choices": [{ "text": "Climb down", "side": "purple" }] }
      ]
    },
    {
      "id": "escape",
      "short": "HER HOME",
      "title": "ESCAPE / basement (choice steps; 4x4 puzzle later)",
      "bg": "basement",
      "enter": "fade",
      "scare": 2,
      "beats": [
        { "props": { "shelf": null }, "text": "Concrete. One bulb. Rain at a high window.", "sfx": "drone", "motion": true, "rmAlt": "static",
          "choices": [{ "text": "Look at the shelves", "side": "purple" }] },
        { "props": { "shelf": "jars" }, "text": "Jars on the shelves. Each one: a date, a name.", "sfx": "thump" },
        { "text": "The dates go back years. The names are all different." },
        { "props": { "shelf": "bentos" }, "text": "Bento boxes, one per day. Your name on each. Untouched.", "sfx": "tick" },
        { "text": "The oldest is dated before you met." },
        { "props": { "shelf": "usu" }, "text": "A mortar and a mallet. One fresh mochi. Hers only.", "sfx": "tick",
          "choices": [{ "text": "Keep looking", "side": "purple" }] },
        { "props": { "shelf": "newest" }, "sfx": "thump", "vary": {"bento": {"umeboshi": {"text": "Newest jar: today, your name, umeboshi. Lid off. Empty.", "props": {"jar": "umeboshi"}}, "tamagoyaki": {"text": "Newest jar: today, your name, tamagoyaki. Lid off. Empty.", "props": {"jar": "tamagoyaki"}}}} },
        { "bg": "blackout", "props": { "phase": "dark" }, "sfx": "silence", "auto": 500 },
        { "bg": "basement", "props": { "shelf": "newest" }, "auto": 700 },
        { "bg": "blackout", "props": { "phase": "dark" }, "auto": 1000 },
        { "bg": "basement", "props": { "shelf": "newest" }, "auto": 700 },
        { "bg": "blackout", "props": { "phase": "dark" }, "auto": 2000 },
        { "bg": "basement", "props": { "shelf": null }, "text": "Minutes gone. A clock upstairs chimed. You lost count.", "sfx": "bell" },
        { "text": "A heavy door. Behind it, stairs to the street.", "sfx": "rain", "timer": 12,
          "choices": [
            { "text": "Wait for her", "side": "pink", "default": true, "go": "escape-timeout", "love": 1 },
            { "text": "Leave her house", "side": "purple", "go": "escape-win", "love": -3 }
          ] }
      ]
    },
    {
      "id": "escape-win",
      "title": "ENDING / ESCAPE (clear)",
      "bg": "BG-D1",
      "scare": 2,
      "beats": [
        { "text": "She's waiting at the outside door.", "sfx": "rain", "vary": {"bento": {"umeboshi": {"props": {"vending": "umeboshi"}}, "tamagoyaki": {"props": {"vending": "tamagoyaki"}}}} },
        { "text": "NANDA: You took the long way.", "sfx": "thump" },
        { "vary": {"bento": {"umeboshi": {"text": "NANDA: You picked sour."}, "tamagoyaki": {"text": "NANDA: Home is warm, and sweet."}}} },
        { "sfx": "breath", "vary": {"bento": {"umeboshi": {"text": "NANDA: Now every hour is ours."}, "tamagoyaki": {"text": "NANDA: Sleep now. You're mine to keep."}}} },
        { "bg": "blackout", "props": { "phase": "dark" }, "sfx": "drone", "auto": 1200 },
        { "text": "NANDA: Mine.", "sfx": "silence" },
        { "text": "ESCAPE.", "sfx": "static", "hold": 1500, "end": "escape", "choices": [{ "text": "Back to start", "go": "rooftop" }] }
      ]
    },
    {
      "id": "escape-timeout",
      "title": "ENDING / ESCAPE (timeout)",
      "bg": "BG-D3",
      "scare": 2,
      "beats": [
        { "text": "The ladder creaks. She's coming down.", "sfx": "thump" },
        { "bg": "blackout", "props": { "phase": "dark" }, "sfx": "drone", "auto": 1200 },
        { "bg": "BG-D2", "props": { "cups": 4 }, "text": "You wake at the tea table. Four cups now.", "sfx": "kettle" },
        { "sfx": "thump", "vary": {"bento": {"umeboshi": {"text": "She holds out an umeboshi. You eat.", "props": {"feed": "umeboshi"}}, "tamagoyaki": {"text": "She holds out the tamagoyaki. You eat.", "props": {"feed": "tamagoyaki"}}}} },
        { "vary": {"bento": {"umeboshi": {"text": "NANDA: すっぱいでしょ。…ね？"}, "tamagoyaki": {"text": "NANDA: 甘いでしょ。…ね？"}}} },
        { "vary": {"bento": {"umeboshi": {"text": "NANDA: One sour hour…"}, "tamagoyaki": {"text": "NANDA: One sweet bite…"}}} },
        { "sfx": "breath", "vary": {"bento": {"umeboshi": {"text": "NANDA: …then every hour is ours."}, "tamagoyaki": {"text": "NANDA: …then sleep. You're mine to keep."}}} },
        { "text": "ESCAPE?", "sfx": "static", "hold": 1500, "end": "escape", "choices": [{ "text": "Back to start", "go": "rooftop" }] }
      ]
    },
    {
      "id": "leave",
      "short": "LEAVE",
      "title": "LEAVE / XOR Coffee 7:00 AM",
      "bg": "BG-D1",
      "scare": 1,
      "beats": [
        { "text": "NANDA: Leaving is not an option.", "scare": 2, "sfx": "thump" },
        { "bg": "BG-X1", "text": "XOR Coffee. 7:00 AM.", "scare": 0, "sfx": "static" },
        { "text": "NANDA: He wakes at 7:00.", "sfx": "tick",
          "choices": [
            { "text": "Who's 'he'?", "side": "pink", "love": 1, "emote": "sweat", "react": "Nobody. Not anymore." },
            { "text": "Stop following me", "side": "purple", "love": -2, "emote": "or", "react": "I was here first." }
          ] },
        { "text": "NANDA: From now on… can we be f{OR}ever?", "scare": 2, "sfx": "breath",
          "choices": [
            { "text": "uhmmm yeah ig", "side": "pink", "go": "leave-yeah", "love": 1 },
            { "text": "FUCK YOU. I'm leaving", "side": "purple", "go": "leave-fu", "love": -5 }
          ] }
      ]
    },
    {
      "id": "leave-fu",
      "title": "ENDING / LEAVE (refuse)",
      "bg": "BG-X1",
      "scare": 2,
      "beats": [
        { "text": "Her hand rises. Time freezes. The café turns.", "sfx": "silence" },
        { "text": "NANDA: You said leave. I heard 'lea—'.", "sfx": "breath" },
        { "text": "CROWD: f{OR}ever and ever", "sfx": "drone" },
        { "text": "CROWD: f{OR}ever and ever and ever", "sfx": "drone" },
        { "text": "LEAVE.", "sfx": "static", "hold": 1500, "end": "leave", "choices": [{ "text": "Back to start", "go": "rooftop" }] }
      ]
    },
    {
      "id": "leave-yeah",
      "title": "ENDING / LEAVE (agree)",
      "bg": "BG-X1",
      "scare": 2,
      "beats": [
        { "text": "NANDA: Hooray! F{OR}ever and ever!", "sfx": "bell" },
        { "text": "NANDA: Good input.", "sfx": "breath" },
        { "text": "CROWD: f{OR}ever and ever", "sfx": "drone" },
        { "text": "CROWD: f{OR}ever and ever and ever", "sfx": "drone" },
        { "text": "LEAVE.", "sfx": "static", "hold": 1500, "end": "leave", "choices": [{ "text": "Back to start", "go": "rooftop" }] }
